156	  chart_ggplot <- reactive({
157	    d <- plot_data()
158	    x <- input$xvar
159	    y <- input$yvar
160	    kind <- input$chart_type
161	    req(x, kind)
162	    validate(need(x %in% names(d), "Pilih variabel X."))
163	
164	    if (kind == "hist") {
165	      validate(need(is.numeric(d[[x]]), "Histogram memerlukan variabel X numerik."))
166	      g <- ggplot(d, aes(x = .data[[x]])) +
167	        geom_histogram(bins = 30, fill = "#2878b5", color = "white", na.rm = TRUE) +
168	        labs(x = x, y = "Frekuensi", title = paste("Histogram", x))
169	    } else if (kind == "box") {
170	      validate(need(is.numeric(d[[x]]), "Boxplot memerlukan variabel X numerik."))
171	      g <- ggplot(d, aes(y = .data[[x]])) +
172	        geom_boxplot(fill = "#71bedb", na.rm = TRUE) +
173	        labs(x = NULL, y = x, title = paste("Boxplot", x))
174	    } else if (kind == "bar") {
175	      counts <- sort(table(as.character(d[[x]]), useNA = "ifany"), decreasing = TRUE)
176	      validate(need(length(counts) > 0, "Tidak ada data untuk grafik batang."))
177	      counts <- head(counts, 25)
178	      dc <- data.frame(Kategori = factor(names(counts), levels = rev(names(counts))),
179	                       Jumlah = as.integer(counts))
180	      g <- ggplot(dc, aes(x = Kategori, y = Jumlah)) +
181	        geom_col(fill = "#2878b5") + coord_flip() +
182	        labs(x = x, y = "Jumlah", title = paste("Frekuensi kategori:", x, "(maks. 25)"))
183	    } else {
184	      validate(need(nzchar(y) && y %in% names(d), "Pilih variabel Y numerik."),
185	               need(is.numeric(d[[x]]) && is.numeric(d[[y]]), "Scatter plot membutuhkan X dan Y numerik."),
186	               need(sum(complete.cases(d[, c(x, y), drop = FALSE])) >= 2, "Dibutuhkan setidaknya 2 pasangan data lengkap."))
187	      g <- ggplot(d, aes(x = .data[[x]], y = .data[[y]])) +
188	        geom_point(color = "#2878b5", alpha = 0.75, na.rm = TRUE) +
189	        geom_smooth(method = "lm", se = TRUE, color = "#e07b39", na.rm = TRUE) +
190	        labs(x = x, y = y, title = paste("Scatter plot:", x, "vs", y))
191	    }
192	    g + theme_minimal(base_size = 13)
193	  })
