202	  cor_matrix <- reactive({
203	    d <- dataset()
204	    nv <- numeric_vars()
205	    validate(need(length(nv) >= 2, "Korelasi memerlukan minimal dua kolom numerik."))
206	    keep <- nv[vapply(d[nv], function(z) sum(!is.na(z)) >= 3 &&
207	                          is.finite(stats::sd(z, na.rm = TRUE)) && stats::sd(z, na.rm = TRUE) > 0, logical(1))]
208	    validate(need(length(keep) >= 2, "Perlu minimal dua kolom numerik dengan variasi nilai dan >= 3 data terisi."))
209	    cor(d[keep], use = "pairwise.complete.obs", method = input$cor_method)
210	  })
