225	  pair_data <- reactive({
226	    d <- dataset()
227	    x <- input$xvar; y <- input$yvar
228	    validate(need(!is.null(x) && !is.null(y) && nzchar(y), "Pilih X dan Y numerik."),
229	             need(x %in% numeric_vars() && y %in% numeric_vars(), "X dan Y harus numerik."),
230	             need(x != y, "X dan Y harus berbeda."))
231	    df <- data.frame(x = d[[x]], y = d[[y]])
232	    df <- df[complete.cases(df) & is.finite(df$x) & is.finite(df$y), , drop = FALSE]
233	    validate(need(nrow(df) >= 3, "Dibutuhkan minimal 3 pasangan observasi lengkap."),
234	             need(sd(df$x) > 0 && sd(df$y) > 0, "X dan Y harus memiliki variasi nilai."))
235	    df
